# Ajustes del producto para `core` (#174). Se cargan con `env_file` en docker-compose.yml.
#
# Aquí van las reglas del sistema, iguales para todo el equipo y sin nada secreto. Los secretos y lo que
# cambia según la máquina van en `.env` (ver .env.example). Cada valor se escribe `${CLAVE:-valor}`: el
# valor es el de este archivo, salvo que la misma CLAVE esté en `.env` o en la shell. Por ejemplo:
#   LLM_MAX_QUEUE_WAIT_SECONDS=60 docker compose up -d core
# Los defaults del código son los mismos, así que fuera de Docker se comporta igual.

# Límite del proveedor del LLM (A-2): solicitudes por minuto por modelo. Un turno espera cupo hasta
# MAX_QUEUE_WAIT segundos y, si no lo hay, responde con un texto seguro.
LLM_RATE_LIMIT_PER_MINUTE=${LLM_RATE_LIMIT_PER_MINUTE:-10}
LLM_MAX_QUEUE_WAIT_SECONDS=${LLM_MAX_QUEUE_WAIT_SECONDS:-15}

# Reintentos ante errores transitorios de Bedrock (A-14, DT-30): throttling, servicio no disponible, timeout
# del modelo, error interno y fallos de conexión. Los demás errores (permisos, petición inválida, modelo
# inexistente) no se reintentan. La espera crece como BASE * 2^(intento-1), con jitter, hasta MAX_DELAY; si
# Bedrock indica cuánto esperar, se respeta. MAX_TOTAL es el tope de tiempo que un turno puede dedicar a
# reintentar; agotado, responde con el texto seguro. MAX_ATTEMPTS=1 desactiva los reintentos.
LLM_RETRY_MAX_ATTEMPTS=${LLM_RETRY_MAX_ATTEMPTS:-4}
LLM_RETRY_BASE_DELAY_SECONDS=${LLM_RETRY_BASE_DELAY_SECONDS:-0.5}
LLM_RETRY_MAX_DELAY_SECONDS=${LLM_RETRY_MAX_DELAY_SECONDS:-8}
LLM_RETRY_MAX_TOTAL_SECONDS=${LLM_RETRY_MAX_TOTAL_SECONDS:-20}

# Scheduler de tareas diferidas (A-17, DT-44). Con este silencio en DISCOVERY o NURTURE, el bot le envía al
# lead un seguimiento; tras FOLLOW_UPS seguimientos sin respuesta, DISCOVERY pasa a NURTURE y NURTURE a LOST.
# POLL_SECONDS es cada cuánto busca jobs vencidos; 0 lo apaga.
SCHEDULER_POLL_SECONDS=${SCHEDULER_POLL_SECONDS:-30}
SCHEDULER_DISCOVERY_HOURS=${SCHEDULER_DISCOVERY_HOURS:-24}
SCHEDULER_NURTURE_DAYS=${SCHEDULER_NURTURE_DAYS:-7}
SCHEDULER_FOLLOW_UPS=${SCHEDULER_FOLLOW_UPS:-2}

# Cada cuántos minutos se buscan propiedades nuevas para las alertas de los leads (A-18, DT-45).
ALERT_SCAN_MINUTES=${ALERT_SCAN_MINUTES:-10}

# Reporte semanal al gerente (N-10, DT-47): el día (0 = lunes) y la hora local en que sale. Los chats que
# lo reciben van en `.env` (WEEKLY_REPORT_CHAT_IDS).
WEEKLY_REPORT_WEEKDAY=${WEEKLY_REPORT_WEEKDAY:-0}
WEEKLY_REPORT_HOUR=${WEEKLY_REPORT_HOUR:-9}
