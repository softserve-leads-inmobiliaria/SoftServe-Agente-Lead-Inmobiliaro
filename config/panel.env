# Ajustes del producto para `panel` (#174). Se cargan con `env_file` en docker-compose.yml; mismas reglas
# que config/core.env: sin secretos, y cada valor se puede pisar con la misma CLAVE en `.env` o en la shell.

# Minutos que un lead HOT puede esperar sin que nadie lo tome ("en gestión") antes de marcarse en la cola
# (B-12). Entero mayor que cero; un valor inválido impide arrancar el panel.
SLA_HOT_MINUTES=${SLA_HOT_MINUTES:-30}

# Nombre público del bot de Telegram (B-16), sin `@`. La landing pública arma los enlaces
# https://t.me/<usuario>?start=<prop_...>. No es secreto (el del core sí: TELEGRAM_BOT_TOKEN, en `.env`).
# Un valor vacío es válido: el panel arranca igual y la landing muestra las propiedades sin botón.
TELEGRAM_BOT_USERNAME=${TELEGRAM_BOT_USERNAME:-}

# Modo demo del login (B-17, DT-72). Con 1, el panel acepta el secreto de sesión de ejemplo que trae
# docker-compose.yml; con 0, exige un PANEL_SESSION_SECRET propio en `.env` o no arranca.
PANEL_DEMO=${PANEL_DEMO:-1}
