# Copiar a `.env` solo si querés cambiar algún valor: docker-compose.yml ya trae estos mismos
# defaults, así que `docker compose up` funciona sin este archivo. `.env` nunca se commitea.

# Dirección donde se publican los puertos del stack (#104). 127.0.0.1 = solo esta máquina.
# 0.0.0.0 los abre a toda la red local, incluida la base con la contraseña de desarrollo.
BIND_ADDRESS=127.0.0.1

# Postgres + pgvector
POSTGRES_USER=leads
POSTGRES_PASSWORD=leads_dev_password
POSTGRES_DB=leads
POSTGRES_PORT=5432

# Phoenix (observabilidad): UI/OTLP-HTTP y OTLP-gRPC
PHOENIX_UI_PORT=6006
PHOENIX_OTLP_GRPC_PORT=4317

# Nivel de los logs JSON de core, catalog y panel (OBS-7): DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Panel de asesores
PANEL_PORT=8080

# Core (fake): puerto en tu máquina; el catalog solo se ve dentro de la red de Docker
CORE_PORT=8000

# Telegram (B-1, DT-4): token de @BotFather. Vacío = el bot no arranca y el core solo atiende
# /events; los tests y el arnés no lo necesitan. Long polling, sin URL pública ni túnel.
TELEGRAM_BOT_TOKEN=

# Trazas por turno (OBS-1): por defecto NO llevan el texto de los mensajes de los leads.
# Poner TRACE_CONTENT=1 solo para depurar en local con datos de prueba.
TRACE_CONTENT=

# LLM del agente (A-2, DT-6). `fake` = respuestas fijas, sin credenciales (por defecto).
# Con `bedrock` hacen falta los dos modelos y credenciales de AWS. Los IDs de modelo de abajo son
# ejemplos SIN VERIFICAR: algunos modelos de Bedrock exigen un inference profile; probar una llamada
# real de un token antes de darlos por buenos.
LLM_PROVIDER=fake
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID_CHAT=
BEDROCK_MODEL_ID_CLASSIFIER=
# Límite del proveedor: 10 solicitudes/minuto por modelo. Un turno espera cupo hasta este número de
# segundos y, si no lo hay, responde con un texto seguro.
LLM_RATE_LIMIT_PER_MINUTE=10
LLM_MAX_QUEUE_WAIT_SECONDS=15
# Reintentos ante errores transitorios de Bedrock (A-14): throttling, servicio no disponible, timeout
# del modelo, error interno y fallos de conexión. Los demás errores (permisos, petición inválida,
# modelo inexistente) no se reintentan. La espera crece como BASE * 2^(intento-1), con jitter, hasta
# MAX_DELAY; si Bedrock indica cuánto esperar, se respeta. MAX_TOTAL es el tope de tiempo que un turno
# puede dedicar a reintentar; agotado, responde con el texto seguro. MAX_ATTEMPTS=1 desactiva los reintentos.
LLM_RETRY_MAX_ATTEMPTS=4
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_RETRY_MAX_DELAY_SECONDS=8
LLM_RETRY_MAX_TOTAL_SECONDS=20
# Scheduler de tareas diferidas (A-17, DT-44). Con este silencio en DISCOVERY o NURTURE, el bot le envía al
# lead un seguimiento; tras FOLLOW_UPS seguimientos sin respuesta, DISCOVERY pasa a NURTURE y NURTURE a LOST.
# POLL_SECONDS es cada cuánto busca jobs vencidos; 0 lo apaga.
SCHEDULER_POLL_SECONDS=30
SCHEDULER_DISCOVERY_HOURS=24
SCHEDULER_NURTURE_DAYS=7
SCHEDULER_FOLLOW_UPS=2
# Cada cuántos minutos se buscan propiedades nuevas para las alertas de los leads (A-18, DT-45).
ALERT_SCAN_MINUTES=10
# Credenciales de AWS (o AWS_PROFILE si se corre fuera de Docker).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

