# Copiar a `.env` solo si querés cambiar algún valor: docker-compose.yml ya trae estos mismos
# defaults, así que `docker compose up` funciona sin este archivo. `.env` nunca se commitea.

# Postgres + pgvector
POSTGRES_USER=leads
POSTGRES_PASSWORD=leads_dev_password
POSTGRES_DB=leads
POSTGRES_PORT=5432

# Phoenix (observabilidad): UI/OTLP-HTTP y OTLP-gRPC
PHOENIX_UI_PORT=6006
PHOENIX_OTLP_GRPC_PORT=4317

# Panel de asesores
PANEL_PORT=8080

# Core (fake): puerto en tu máquina; el catalog solo se ve dentro de la red de Docker
CORE_PORT=8000

# Telegram (B-1, DT-4): token de @BotFather. Vacío = el bot no arranca y el core solo atiende
# /events; los tests y el arnés no lo necesitan. Long polling, sin URL pública ni túnel.
TELEGRAM_BOT_TOKEN=
