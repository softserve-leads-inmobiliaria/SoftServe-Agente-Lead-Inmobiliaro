# Copiar a `.env` solo si querés cambiar algún valor: docker-compose.yml ya trae estos mismos
# defaults, así que `docker compose up` funciona sin este archivo. `.env` nunca se commitea.
#
# Aquí van solo los secretos y lo que cambia según la máquina o el despliegue. Los ajustes del producto
# (reintentos y límites del LLM, scheduler, alertas, horario del reporte, umbral de atención) están en
# config/core.env y config/panel.env (#174); para pisar uno en tu máquina, poné la misma variable en `.env`.

# Dirección donde se publican los puertos del stack (#104). 127.0.0.1 = solo esta máquina.
# 0.0.0.0 los abre a toda la red local, incluida la base con la contraseña de desarrollo.
BIND_ADDRESS=127.0.0.1

# Postgres + pgvector
POSTGRES_USER=leads
POSTGRES_PASSWORD=leads_dev_password
POSTGRES_DB=leads
POSTGRES_PORT=5432

# Phoenix (observabilidad): UI/OTLP-HTTP y OTLP-gRPC
PHOENIX_UI_PORT=6006
PHOENIX_OTLP_GRPC_PORT=4317

# Nivel de los logs JSON de core, catalog y panel (OBS-7): DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Panel de asesores
PANEL_PORT=8080
# Login del panel (B-17, DT-72). El secreto firma la cookie de sesión: el de ejemplo solo vale en la demo
# (PANEL_DEMO=1 en config/panel.env); para cualquier otro uso, uno propio, p. ej. `openssl rand -hex 32`.
PANEL_SESSION_SECRET=demo-session-secret-change-me
# Contraseñas de demo: una compartida por los asesores (valeria, andres, camila) y otra para `gerente`.
# Las aplica el seed (`docker compose run --rm seed`); se guardan solo como hash.
PANEL_ADVISOR_PASSWORD=asesor-demo
PANEL_MANAGER_PASSWORD=gerente-demo
# Nombre público del bot de Telegram (B-16), sin `@`, para los enlaces de la landing (/properties).
# El default vive en config/panel.env (#174); acá solo se documenta cómo pisarlo (vacío oculta el botón).
# TELEGRAM_BOT_USERNAME=

# Core (fake): puerto en tu máquina; el catalog solo se ve dentro de la red de Docker
CORE_PORT=8000

# Telegram (B-1, DT-4): token de @BotFather. Vacío = el bot no arranca y el core solo atiende
# /events; los tests y el arnés no lo necesitan. Long polling, sin URL pública ni túnel.
TELEGRAM_BOT_TOKEN=

# Trazas por turno (OBS-1): por defecto NO llevan el texto de los mensajes de los leads.
# Poner TRACE_CONTENT=1 solo para depurar en local con datos de prueba.
TRACE_CONTENT=

# LLM del agente (A-2, DT-6). `fake` = respuestas fijas, sin credenciales (por defecto).
# Con `bedrock` hacen falta los dos modelos y credenciales de AWS. Los IDs de modelo de abajo son
# ejemplos SIN VERIFICAR: algunos modelos de Bedrock exigen un inference profile; probar una llamada
# real de un token antes de darlos por buenos.
LLM_PROVIDER=fake
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID_CHAT=
BEDROCK_MODEL_ID_CLASSIFIER=
# Reporte semanal al gerente por Telegram (N-10, DT-47): chats que lo reciben, separados por coma. Vacío: no
# se manda. INCLUDE_SYNTHETIC=1 suma la historia de la demo (N-9). PANEL_PUBLIC_URL es la dirección del
# panel en el enlace del mensaje. El día y la hora del envío están en config/core.env.
WEEKLY_REPORT_CHAT_IDS=
WEEKLY_REPORT_INCLUDE_SYNTHETIC=0
PANEL_PUBLIC_URL=http://localhost:8080
# Credenciales de AWS (o AWS_PROFILE si se corre fuera de Docker).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

